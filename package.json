{
  "private": true,
  "name": "cours-r203",
  "description": "R2.03 — Cours magistraux (build Marp + Kroki)",
  "scripts": {
    "dev": "marp --config marp.config.js --server --html .",
    "build": "mkdir -p _site && for f in cm*.md; do npx marp --config marp.config.js --html \"$f\" --output \"_site/${f%.md}.html\"; done",
    "preview": "marp --config marp.config.js --preview --html cm*.md"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4",
    "@kazumatu981/markdown-it-kroki": "^1"
  }
}
